# Production refuses default or weak secrets.
APP_ENV=development
ADMIN_TOKEN=replace-with-a-long-random-secret
WEBHOOK_TOKEN=replace-with-a-separate-random-secret

DATABASE_PATH=runtime/followdesk.db
BUSINESS_FILE=data/business.json
SEQUENCE_FILE=data/sequence.json
PORT=8000

# The included demo provider records emails without sending them.
EMAIL_PROVIDER=demo
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Set to false if a platform cron calls POST /api/system/process-followups.
FOLLOWUP_WORKER_ENABLED=true
FOLLOWUP_POLL_SECONDS=60
LEAD_RATE_LIMIT_PER_MINUTE=8

# Exact comma-separated origins only when an external form calls the API.
CORS_ORIGINS=
